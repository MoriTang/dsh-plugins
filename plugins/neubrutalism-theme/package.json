{
  "name": "dsh-neubrutalism-theme",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Out-of-tree DeepSeek Harness Web theme implementing the Neubrutalism visual system.",
  "dependencies": {
    "@deepseek-ai/cordis": "link:../../../deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-client-ui-theme": "link:../../../deepseek-harness/packages/client/ui-theme",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource-variable/syne": "5.3.0",
    "@fontsource/space-mono": "5.3.0"
  },
  "devDependencies": {
    "@types/node": "link:../../../deepseek-harness/node_modules/.pnpm/@types+node@26.1.2/node_modules/@types/node",
    "esbuild": "link:../../../deepseek-harness/node_modules/.pnpm/esbuild@0.25.12/node_modules/esbuild",
    "tsx": "link:../../../deepseek-harness/node_modules/.pnpm/tsx@4.22.4/node_modules/tsx",
    "typescript": "link:../../../deepseek-harness/node_modules/.pnpm/typescript@6.0.3/node_modules/typescript"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.build.json",
    "test": "node --import tsx/esm --test tests/*.test.*",
    "typecheck": "tsc --noEmit"
  }
}
